# Mirrors src/env.ts, which validates these when the app starts. Keep the two in sync.

# Postgres (local: the Supabase stack from `supabase start`; production: Supabase transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth and Storage (project "ERMS", eu-central-1)
# Self-serve signup at /signup (EPSILON-130); "true" opens it. Off by default.
SIGNUP_ENABLED=false
PUBLIC_SUPABASE_URL=https://efalpthvvmvpaikuxymd.supabase.co
# A fake key, so `pnpm build` works from a fresh copy. Sign-in needs the real publishable key
# from the project's API settings. Netlify holds the production value.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder-not-a-real-key

# Member invites (EPSILON-87): the Supabase secret key, for the Auth admin API only. Server-side,
# never PUBLIC_. Leave empty to keep invites off. Production holds it in Netlify, never here.
SUPABASE_SECRET_KEY=

# Sign-in email through Supabase's Send Email hook (EPSILON-147). Leave empty while Supabase sends
# over SMTP. Production holds the secret and both Resend keys in Netlify, never here.
SEND_EMAIL_HOOK_SECRET=
RESEND_KEY_EPSILON=
RESEND_KEY_LABELKIT=
AUTH_EMAIL_EPSILON_ORG_ID=

# Audio provider:"stub" for tests, "audiokit" for production
AUDIO_PROVIDER=stub
AUDIOKIT_BASE_URL=https://api.audiokit.ai
# Deployment-wide key: the fallback for a label that has no AudioKit client of its own yet.
AUDIOKIT_API_KEY=
# Org ids (comma-separated) that may use the deployment-wide key while they have no client (EPSILON-135); empty: none
AUDIOKIT_FALLBACK_ORG_IDS=
AUDIOKIT_WEBHOOK_SECRET=
# Per-label AudioKit clients (EPSILON-102). The credentials key seals each label's key and webhook
# secret in the database: "<id>:<base64 of 32 random bytes>", e.g. from `openssl rand -base64 32`.
AUDIOKIT_CREDENTIALS_KEY=
AUDIOKIT_BILLING_URL=
LABEL_CLIENTS_ADMIN_TOKEN=

# Plans and billing (EPSILON-136): billing page and plan limits. Off unless "true".
PLANS_ENABLED=false
# Orgs plan limits never apply to (orgs.id, comma-separated), e.g. Epsilon's own label.
PLAN_LIMITS_EXEMPT_ORG_IDS=

# Master uploads to Cloudflare R2 (decision 0011). Leave empty to keep uploads off.
# Production values live only in Netlify and Supabase secrets, never here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MASTERS_BUCKET=

# Background worker authentication (for /api/audiokit/worker endpoint)
WORKER_SECRET=

# Error monitoring (shared decision 0003). Leave empty to disable Sentry.
# The public DSN is safe for the browser; the private one is server-only.
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# First-party performance pilot: remain false until explicit review/merge/enable approval.
APP_METRICS_ENABLED=false
PUBLIC_APP_METRICS_ENABLED=false

# Cloudflare Web Analytics site token for labelkit.co's public pages (shared 0011, 0016). Public,
# but set it in Netlify's production context only; leave it empty locally. Empty loads nothing.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# PostHog EU, server-side only (shared 0052). Without the keys, features use their defaults.
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
